# Prazos curtos da sessão para os testes ponta a ponta (specs/016-sessao-refresh-token, T002a).
# Exercitam a renovação e o aviso de expiração em toda a suíte sem esperas longas. Uso local:
#   docker compose --env-file .env.e2e.example up -d --build --wait
# (ou copie estas linhas para o seu .env). O CI usa os mesmos valores no job frontend-e2e.
JWT_EXPIRACAO_SEGUNDOS=10
SESSAO_INATIVIDADE_SEGUNDOS=25
SESSAO_TOLERANCIA_REUSO_SEGUNDOS=5
SESSAO_LIMITE_ABSOLUTO_HORAS=8
