# =========================================================
# Ambiente local do Bank — variáveis do docker-compose.yml
#
# Valores exclusivamente para desenvolvimento local. NÃO use em nenhum outro ambiente.
# Copie para .env (não versionado) apenas se precisar alterar algum valor:
#   cp .env.example .env
# Sem .env, o Compose usa exatamente estes mesmos padrões.
# Contrato: specs/001-infra-local/contracts/ambiente-local.md
# =========================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank_dev_password
POSTGRES_DB=bank
POSTGRES_PORT=5432

# ---------- RabbitMQ ----------
RABBITMQ_USER=bank
RABBITMQ_PASSWORD=bank_dev_password
RABBITMQ_VHOST=bank
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- Aspire Dashboard (OpenTelemetry) ----------
ASPIRE_DASHBOARD_PORT=18888
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ---------- API (specs/002-setup-api) ----------
API_PORT=8080

# ---------- JWT (specs/003-usuarios-carteiras) ----------
# SOMENTE DESENVOLVIMENTO: chave de assinatura dos tokens (>= 32 bytes). Nunca reutilize fora
# do ambiente local; em outros ambientes a chave vem de um cofre de segredos.
JWT_CHAVE_ASSINATURA=bank-dev-only-jwt-signing-key-change-me-0123456789

# ---------- Sessão (specs/016-sessao-refresh-token) ----------
# Token de acesso (s), inatividade (s), tolerância para reapresentar uma credencial recém-trocada (s) e
# limite absoluto da sessão (h). Para o e2e, use os prazos curtos de .env.e2e.example.
JWT_EXPIRACAO_SEGUNDOS=300
SESSAO_INATIVIDADE_SEGUNDOS=900
SESSAO_TOLERANCIA_REUSO_SEGUNDOS=30
SESSAO_LIMITE_ABSOLUTO_HORAS=8

# ---------- Frontend (specs/004-frontend-base) ----------
FRONTEND_PORT=3000

# ---------- Limites de transferência (specs/009-limite-transferencia) ----------
# Limites da Pessoa Física em BRL. Valor vazio desliga o limite (ex.: LIMITE_PF_POR_OPERACAO=).
# Valores baixos (ex.: 4.00 e 6.00) permitem ver a recusa com o saldo de demonstração de R$ 10,00.
LIMITE_PF_POR_OPERACAO=1000.00
LIMITE_PF_DIARIO=5000.00

# ---------- Cartão de crédito (specs/014-cartao-credito-cobrancas) ----------
# SOMENTE DESENVOLVIMENTO: chave que deriva número e CVV dos cartões (>= 32 bytes). Trocá-la muda os
# dados de todos os cartões já emitidos. Em outros ambientes vem de um cofre de segredos.
CARTOES_CHAVE_DERIVACAO=bank-dev-only-card-derivation-key-change-me-0123456789
# Limite de crédito dos cartões novos, em BRL (os existentes mantêm o seu).
LIMITE_CARTAO_PADRAO=5000.00
# Juros por atraso da fatura, em % ao mês (cobrados por dia de atraso).
JUROS_ATRASO_MENSAL=15.00
