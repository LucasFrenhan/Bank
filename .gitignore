.env
.env.*
!.env.example
!.env.e2e.example
appsettings.*.local.json
*.pfx
*.p12
*.key
secrets.json

# ---------- .NET ----------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.user
*.userosscache
*.suo
*.rsuser
*.sln.docstates
