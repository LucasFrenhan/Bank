{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mensageria": {
    "Porta": 5672,
    "IntervalosNovaTentativaMs": [ 1000, 2000, 4000 ],
    "Prefetch": 10,
    "IntervaloDespachoMs": 1000,
    "TamanhoLoteDespacho": 50,
    "TimeoutConfirmacaoMs": 5000
  },
  "ProcessamentoDiario": {
    "Habilitado": true,
    "IntervaloSegundos": 60
  },
  "Sessao": {
    "InatividadeSegundos": 900,
    "LimiteAbsolutoHoras": 8,
    "ToleranciaReusoSegundos": 30,
    "RetencaoDias": 7
  },
  "LimpezaSessoes": {
    "Habilitada": true,
    "IntervaloMinutos": 60
  },
  "Persistencia": {
    "AplicarMigracoesNaInicializacao": false,
    "CriarLancamentosDeAberturaNaInicializacao": false
  }
}
